#!/bin/sh
# pre-commit -- proof-number gate + beacon-coverage gate.
#
# Gate 1 blocks a commit if any cited proof number (test count, etc.) in
# committed site content contradicts proof-manifest.toml. See
# scripts/check_proof_numbers.py for the full matching/association rule set.
#
# Gate 2 blocks a commit if any user-facing page loses its GoatCounter
# analytics beacon (or gains a duplicate one), including the scoreboard.html
# generator template. See scripts/check_beacon_coverage.py and
# docs/INSTRUMENTATION-SETUP.md's "Coverage rule" section.
#
# This hook is wired up via:
#   git config core.hooksPath .githooks
# (run once per clone -- see README.md "Dev setup" for the one-line command.)
#
# ASCII-only, POSIX sh, no bashisms -- must run under Git Bash on Windows and
# under bash/sh on Linux/macOS alike.

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Pick an interpreter by CAPABILITY, not by mere existence. The checker
# imports tomllib, which is stdlib only from Python 3.11 -- so the first
# python3 on PATH can exist, launch fine, and still be unable to run the
# gate at all (observed: WSL's /usr/bin/python3 3.10.12). Probing here means
# the failure is reported honestly below instead of surfacing later as a
# traceback that looks like a proof-number disagreement.
PYTHON_BIN=""
for candidate in python3 python py; do
    if command -v "$candidate" >/dev/null 2>&1; then
        if "$candidate" -c "import tomllib" >/dev/null 2>&1; then
            PYTHON_BIN="$candidate"
            break
        fi
    fi
done

if [ -z "$PYTHON_BIN" ]; then
    echo "pre-commit: CANNOT RUN -- no python3/python/py on PATH can import tomllib"
    echo "(stdlib in Python 3.11+). The proof-number gate needs one; this is NOT"
    echo "a finding about your commit's content."
    echo "pre-commit: install Python 3.11+ or fix PATH, then retry the commit."
    exit 1
fi


# Note: the checker call is the condition of this `if`, not a bare command.
# Under `set -e`, a bare failing command aborts the script immediately --
# which previously ran the checker on its own line, then read $? on the
# NEXT line, a line that `set -e` never let the shell reach on failure. That
# skipped the STATUS/if block below entirely, so a blocked commit got a raw
# tool dump with no fix guidance. Using the command directly as the `if`
# condition is exempt from `set -e` (POSIX: the exit status of commands in
# an `if` test is not subject to `set -e`), so both branches always run.
if "$PYTHON_BIN" scripts/check_proof_numbers.py; then
    STATUS=0
else
    STATUS=$?
fi

# Distinguish the checker's VERDICT from the checker CRASHING. Its contract
# is: 0 = clean, 2 = one or more proof numbers disagree. Any other non-zero
# is an uncaught exception, i.e. the gate never reached a verdict at all.
# Branching on `-ne 0` conflated the two, so an interpreter or import failure
# was reported to the operator as "proof numbers disagree" -- sending them to
# audit site content when nothing was wrong with it. Both paths still block
# the commit (fail closed); they just have to say which one happened.
if [ "$STATUS" -eq 2 ]; then
    echo ""
    echo "pre-commit: BLOCKED -- one or more proof numbers in site content"
    echo "disagree with proof-manifest.toml. Fix the cited number (or the"
    echo "manifest, if the manifest itself is stale -- re-run the upstream"
    echo "suite first) and re-commit."
    exit "$STATUS"
fi

if [ "$STATUS" -ne 0 ]; then
    echo ""
    echo "pre-commit: CANNOT RUN -- the proof-number checker exited $STATUS"
    echo "without reaching a verdict (expected 0 = clean or 2 = disagreement)."
    echo "This is a fault in the gate itself, NOT a finding about your commit."
    echo "See the traceback above; the commit is blocked until the gate runs."
    exit "$STATUS"
fi

# Gate 2: beacon-coverage. Reuses PYTHON_BIN validated above (it can import
# tomllib, so it's on 3.11+ and has every stdlib module this checker needs
# too -- no separate probe required). Same set-e-survival pattern as gate 1:
# the checker call is the `if` condition itself, not a bare command, so the
# STATUS2/message branch below always runs even on a non-zero exit (see the
# comment on gate 1's `if` above for why a bare command would be skipped).
if "$PYTHON_BIN" scripts/check_beacon_coverage.py; then
    STATUS2=0
else
    STATUS2=$?
fi

# Same crash-vs-verdict distinction as gate 1's STATUS branch: 0 = clean,
# 2 = one or more pages have lost (or duplicated) their beacon, anything
# else = the gate itself faulted before reaching a verdict.
if [ "$STATUS2" -eq 2 ]; then
    echo ""
    echo "pre-commit: BLOCKED -- one or more user-facing pages have lost (or"
    echo "duplicated) their data-goatcounter analytics beacon. See"
    echo "docs/INSTRUMENTATION-SETUP.md's Coverage rule section, fix the"
    echo "page(s) named above, and re-commit."
    exit "$STATUS2"
fi

if [ "$STATUS2" -ne 0 ]; then
    echo ""
    echo "pre-commit: CANNOT RUN -- the beacon-coverage checker exited $STATUS2"
    echo "without reaching a verdict (expected 0 = clean or 2 = coverage gap)."
    echo "This is a fault in the gate itself, NOT a finding about your commit."
    echo "See the traceback above; the commit is blocked until the gate runs."
    exit "$STATUS2"
fi

exit 0
